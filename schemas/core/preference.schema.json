{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ubunow.net/phase1/core/preference.schema.json",
  "title": "Preference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id-registry.schema.json#/$defs/preference_id"
    },
    "task_a": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id-registry.schema.json#/$defs/task_id"
    },
    "task_b": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id-registry.schema.json#/$defs/task_id"
    },
    "objective_a": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id-registry.schema.json#/$defs/objective_id"
    },
    "objective_b": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id-registry.schema.json#/$defs/objective_id"
    },
    "order": {
      "enum": [
        "a_preferred_to_b",
        "a_indifferent_to_b"
      ]
    },
    "acquired_method": {
      "enum": [
        "user_defined",
        "llm_estimated"
      ]
    },
    "acquired_date": {
      "$ref": "https://schemas.ubunow.net/phase1/common/timestamp.schema.json"
    },
    "enabled": {
      "type": "boolean"
    },
    "provenance": {
      "$ref": "https://schemas.ubunow.net/phase1/common/provenance.schema.json"
    }
  },
  "required": [
    "id",
    "order",
    "acquired_method",
    "acquired_date",
    "enabled",
    "provenance"
  ],
  "oneOf": [
    {
      "required": [
        "task_a",
        "task_b"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "objective_a"
            ]
          },
          {
            "required": [
              "objective_b"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "objective_a",
        "objective_b"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "task_a"
            ]
          },
          {
            "required": [
              "task_b"
            ]
          }
        ]
      }
    }
  ]
}
