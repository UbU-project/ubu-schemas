{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ubunow.net/phase1/core/device-registration.schema.json",
  "title": "Device Registration",
  "description": "Operator-controlled execution enclave registration, held outside canonical mutable state. A registry of one confers no global authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["os_user_profile", "container", "virtual_machine", "secure_enclave", "browser_profile", "browser_session", "worker_process", "worker_runtime"]
    },
    "registered_at": { "$ref": "https://schemas.ubunow.net/phase1/common/timestamp.schema.json" },
    "registered_identity_id": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id.schema.json",
      "pattern": "^identity_"
    },
    "trust_state": { "type": "string", "enum": ["registered", "revoked"] },
    "sync_state": {
      "description": "Phase 1b local-only registration, never synced.",
      "type": "string",
      "enum": ["local_only"]
    },
    "zone_id": { "type": "string", "minLength": 1 },
    "capability_profile": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "compartment_access": {
      "description": "Explicit Compartment allowlist. Any label absent from this list is denied, even in a registry containing only one Device.",
      "type": "array",
      "items": { "$ref": "https://schemas.ubunow.net/phase1/common/compartment-label.schema.json" },
      "uniqueItems": true
    },
    "last_seen_at": { "$ref": "https://schemas.ubunow.net/phase1/common/timestamp.schema.json" }
  },
  "required": [
    "device_id", "label", "kind", "registered_at", "registered_identity_id",
    "trust_state", "sync_state", "zone_id", "capability_profile", "compartment_access"
  ]
}
