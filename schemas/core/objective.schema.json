{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ubunow.net/phase1/core/objective.schema.json",
  "title": "Objective",
  "type": "object",
  "description": "A desired outcome that can be decomposed into tasks or plans.",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "active",
        "satisfied",
        "abandoned"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "compartment_id": {
      "$ref": "https://schemas.ubunow.net/phase1/common/id.schema.json"
    },
    "provenance": {
      "$ref": "https://schemas.ubunow.net/phase1/common/provenance.schema.json"
    },
    "mode": {
      "enum": [
        "one_time",
        "evergreen"
      ],
      "default": "one_time"
    },
    "recurrence": {
      "$ref": "#/$defs/schedule"
    },
    "routine_instance_template": {
      "$ref": "#/$defs/template"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "provenance"
  ],
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+\\-]+)+)$"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "enabled_from": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "enabled_until": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "exdates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "uniqueItems": true
        },
        "schedule_version": {
          "type": "integer",
          "minimum": 1
        },
        "overrides": {
          "type": "array",
          "x-ubu-unique-by": "local_date",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "local_date": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "start": {
                "$ref": "https://schemas.ubunow.net/phase1/common/timestamp.schema.json"
              },
              "end": {
                "$ref": "https://schemas.ubunow.net/phase1/common/timestamp.schema.json"
              }
            },
            "required": [
              "local_date",
              "start",
              "end"
            ],
            "x-ubu-timestamp-order": [
              "start",
              "end"
            ]
          }
        }
      },
      "required": [
        "timezone",
        "rule",
        "schedule_version"
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "daily"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "weekly"
            },
            "weekdays": {
              "type": "array",
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "weekdays"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "monthly_day"
            },
            "days": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "days"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "first_workday_of_month"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "first_workday_of_quarter"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "duration_estimate": {
          "description": "Optional duration model. When absent, downstream planning applies its fixed default.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "const": "fixed"
                },
                "seconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "type",
                "seconds"
              ]
            },
            {
              "type": "object",
              "description": "A shifted log-normal estimate ordered as 0 <= min_seconds < mode_seconds < p95_seconds.",
              "additionalProperties": false,
              "x-ubu-strictly-increasing": [
                "min_seconds",
                "mode_seconds",
                "p95_seconds"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "shifted_lognormal_p95"
                },
                "min_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode_seconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "p95_seconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "type",
                "min_seconds",
                "mode_seconds",
                "p95_seconds"
              ]
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "category_tag": {
          "type": "string",
          "minLength": 1
        },
        "reminder_minutes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "nominal_start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "placement": {
          "enum": [
            "static",
            "planned"
          ]
        },
        "allowed_local_range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "earliest": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
            },
            "latest": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
            }
          },
          "required": [
            "earliest",
            "latest"
          ]
        },
        "occupies_capacity": {
          "type": "boolean",
          "default": true
        },
        "after": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objective_id": {
                "type": "string",
                "pattern": "^obj_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
              },
              "minimum_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "maximum_seconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "objective_id",
              "minimum_seconds"
            ]
          }
        },
        "template_version": {
          "type": "integer",
          "minimum": 1
        },
        "effects": {
          "$ref": "https://schemas.ubunow.net/phase1/core/task.schema.json#/properties/effects"
        },
        "preconditions": {
          "$ref": "https://schemas.ubunow.net/phase1/core/precondition.schema.json"
        }
      },
      "required": [
        "title",
        "duration_estimate",
        "nominal_start",
        "placement",
        "template_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "const": "planned"
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "required": [
              "allowed_local_range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "placement": {
                "const": "static"
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "not": {
              "required": [
                "allowed_local_range"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "recurrence"
        ]
      },
      "then": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "evergreen"
          }
        },
        "not": {
          "required": [
            "priority"
          ]
        }
      }
    }
  ],
  "dependentRequired": {
    "routine_instance_template": [
      "recurrence"
    ]
  }
}
