{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ubunow.net/phase1/worker/planning-stream-frame.schema.json",
  "title": "Planning Stream Frame",
  "type": "object",
  "description": "Planning Stream Frame for the approved legacy planning-kernel-contract/0.1 invocation profile.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "planning-kernel-contract/0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_type": {
          "const": "chunk_result"
        },
        "chunk_depth": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "partial_response": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "frame_index",
        "frame_type",
        "chunk_depth",
        "chunk_id",
        "partial_response"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "planning-kernel-contract/0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_type": {
          "const": "final_response"
        },
        "response": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "frame_index",
        "frame_type",
        "response"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "planning-kernel-contract/0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_type": {
          "const": "engine_error"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "frame_index",
        "frame_type",
        "error"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "planning-kernel-contract/0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_type": {
          "const": "cancelled"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "frame_index",
        "frame_type"
      ]
    }
  ]
}
